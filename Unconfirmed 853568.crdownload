    ck: [['Isolate, do not wipe', 'Disconnect affected machines from the network instead of switching them off or reinstalling.'], ['Preserve logs', 'Export firewall, VPN, email and cloud logs before they roll over.'], ['Record what you see', 'Photograph screens and ransom notes; write down times and actions.'], ['Limit access', 'Let as few people as possible touch the affected systems.'], ['Do not pay or negotiate yet', 'Preserve evidence first and take specialist advice.'], ['Keep original emails', 'With full headers, and do not forward them internally.'], ['Start a chain of custody', 'Record who received each device or copy, when and why.'], ['Call legal counsel and an independent expert', 'Early decisions shape the strength of any later case.']],
    hTitle: 'Verify the integrity of digital evidence', hDrop: 'Drop a file here, or click to choose one', hPriv: 'The fingerprint is calculated inside your browser. The file is never uploaded anywhere.',
    hName: 'File', hSize: 'Size', hMod: 'Last modified', hCmp: 'Paste a previously recorded SHA-256 hash to compare', hBtn: 'Compare', hOk: 'Match: the file has not changed since the hash was recorded.', hBad: 'No match: the file has changed, or it is a different file.', hWork: 'Calculating fingerprint…', hBig: 'The file is too large to process in the browser (limit 500 MB).',
    tabs: [
      ['ransom', 'Ransomware', ['How the attacker got in and which weakness was used', 'The ransomware family and its behaviour', 'Data taken before encryption'], ['When did the attack start, and how did it spread?', 'Was data stolen, or only encrypted?', 'Were security controls reasonable?'], ['Infected machines as they are', 'Firewall and VPN logs', 'The ransom note and any contact with the attacker']],
      ['breach', 'Data breach', ['Access and audit logs', 'How the data left the network', 'Configuration of affected systems'], ['What data leaked, and when?', 'Who had access?', 'Was it negligence or an attack?'], ['Server and cloud logs', 'Permission lists', 'Copies of the leaked data, if found']],
      ['bec', 'Email fraud', ['Email headers and delivery path', 'Look-alike spoofed domains', 'Mailbox forwarding rules'], ['Was the mailbox hacked, or the email forged?', 'Who really sent the message?', 'How long had the attacker been watching?'], ['Original emails in full', 'Mailbox sign-in logs', 'Bank transfer details']],
      ['insider', 'Insider theft', ['Account activity before departure', 'Copies to USB drives or personal cloud', 'Deleted or hidden data'], ['Which files were copied, and when?', 'Was the copying within their permissions?', 'Where did the data go?'], ["The employee's device as it is", 'Email and cloud logs', 'External-device logs']],
      ['wa', 'WhatsApp chats', ['The chat database on the phone', 'Timestamps, and deleted or edited messages', 'Linking the number to its owner and device'], ['Is the chat genuine, not fabricated?', 'Who sent the message, and when?', 'Were messages deleted or edited?'], ['The original phone as it is', 'Cloud backups', "The other party's phone, if possible"]],
      ['sale', 'Buying & selling disputes', ['Whether the device or software matches the agreed specification', 'Manufacturing defects versus misuse', 'Serial numbers and device history'], ['Is the device new, used or refurbished?', 'Did the defect exist before the sale?', 'Does the software work as the contract says?'], ['The device or software, unmodified', 'Contract, invoices and specifications', 'Messages between buyer and seller']],
      ['value', 'Device valuation', ['Model, specification and purchase date', 'Technical condition and faults', 'Market prices of comparable devices'], ['What was the market value at the time of the dispute?', 'What would repair or replacement cost?', 'Was the price paid fair for its condition?'], ['The device and accessories', 'Purchase invoice and warranty', 'Previous repair reports']],
      ['dispute', 'Disputed records', ['Metadata of files and messages', 'The sending device and account', 'Traces of editing or tampering'], ['Is the message or document authentic?', 'When was it created or changed?', 'Which device or account sent it?'], ['Original devices and accounts', 'Electronic copies, not printouts', 'A custody record for each copy']]
    ],
    tH: ['What I examine', 'Questions I answer for the court', 'Evidence to preserve'],
    toastCopied: 'Copied'
  };

  var toastEl = document.createElement('div'); toastEl.className = 'ew-toast'; toastEl.hidden = true; toastEl.setAttribute('role', 'status'); document.body.appendChild(toastEl);
  var tt; function toast(m) { toastEl.textContent = m; toastEl.hidden = false; clearTimeout(tt); tt = setTimeout(function () { toastEl.hidden = true; }, 2200); }
  function copyText(text, okMsg, el) {
    function fallback() { if (el) { var r = document.createRange(); r.selectNodeContents(el); var s = getSelection(); s.removeAllRanges(); s.addRange(r); } toast(T.selected); }
    try { navigator.clipboard.writeText(text).then(function () { toast(okMsg); }, fallback); } catch (e) { fallback(); }
  }
  var waLink = function (text) { return 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(text); };

  /* floating contact */
  var fab = document.createElement('div'); fab.className = 'ew-fab';
  fab.innerHTML = '<a class="wa" href="' + waLink(AR ? 'مرحباً د. معتز، أرغب في استشارة بخصوص قضية تتعلق بالأمن السيبراني.' : 'Hello Dr. Moutaz, I would like to discuss a cybersecurity matter.') + '" target="_blank" rel="noopener" aria-label="WhatsApp ' + PHONE_TXT + '" title="WhatsApp">' + ICON.wa + '</a>' +
    '<a class="call" href="tel:+' + PHONE + '" aria-label="' + (AR ? 'اتصال ' : 'Call ') + PHONE_TXT + '" title="' + PHONE_TXT + '">' + ICON.call + '</a>';
  document.body.appendChild(fab);

  /* hero CTA buttons */
  var heroCta = document.getElementById('ew-hero-cta');
  if (heroCta) heroCta.innerHTML =
    '<a class="ew-btn gold" href="#ew-assess">' + (AR ? 'قيّم حالتك الآن' : 'Assess your case now') + '</a>' +
    '<a class="ew-btn wa" href="' + waLink(AR ? 'مرحباً د. معتز، أرغب في استشارة بخصوص قضية تتعلق بالأمن السيبراني.' : 'Hello Dr. Moutaz, I would like to discuss a cybersecurity matter.') + '" target="_blank" rel="noopener">' + ICON.wa + ' WhatsApp</a>' +
    '<a class="ew-btn ghost" href="tel:+' + PHONE + '">' + ICON.call + ' <bdi dir="ltr">' + PHONE_TXT + '</bdi></a>';

  /* case assessment wizard */
  var wiz = document.getElementById('ew-assess-tool');
  if (wiz) {
    var st = { step: 0, type: null, when: null, role: null, ev: [] };
    var left = document.createElement('div'), right = document.createElement('div'); right.className = 'ew-result';
    wiz.className = 'ew-wiz'; wiz.appendChild(left); wiz.appendChild(right);
    var lists = [T.types, T.when, T.role, T.ev], keys = ['type', 'when', 'role', 'ev'];
    function label(list, id) { for (var i = 0; i < list.length; i++) if (list[i][0] === id) return list[i][list[i].length - 1]; return id; }
    function drawLeft() {
      var s = st.step, list = lists[s], multi = s === 3;
      var h = '<div class="ew-steps" aria-hidden="true">' + T.steps.map(function (_, i) { return '<i class="' + (i <= s ? 'on' : '') + '"></i>'; }).join('') + '</div>';
      h += '<p class="ew-q">' + (s + 1) + ' / 4 · ' + esc(T.q[s]) + '</p><div class="ew-opts" role="group" aria-label="' + esc(T.q[s]) + '">';
      list.forEach(function (o) {
        var on = multi ? st.ev.indexOf(o[0]) >= 0 : st[keys[s]] === o[0];
        h += '<button type="button" class="ew-opt" data-v="' + o[0] + '" aria-pressed="' + on + '">' + (o.length === 3 ? '<span class="ic" aria-hidden="true">' + o[1] + '</span>' : '') + '<span>' + esc(o[o.length - 1]) + '</span></button>';
      });
      h += '</div><div class="ew-nav"><button type="button" class="ew-btn line" data-nav="back"' + (s === 0 ? ' disabled style="opacity:.4;cursor:default"' : '') + '>' + T.back + '</button>' +
        '<button type="button" class="ew-btn dark" data-nav="next">' + (s === 3 ? T.see : T.next) + '</button></div>';
      left.innerHTML = h;
    }
    function drawRight() {
      if (!(st.type && st.when && st.role) || st.step < 4) { right.innerHTML = '<h3>' + T.emptyTitle + '</h3><p class="ew-empty">' + T.empty + '</p>'; return; }
      var urgent = st.when === 'now' || (st.when === 'week' && /ransom|breach|bec|hack/.test(st.type));
      var lvl = urgent ? 'hi' : (st.when === 'older' ? 'lo' : 'md');
      var acts = T.act[st.type].slice(); acts.push(T.roleTip[st.role]);
      if (st.ev.indexOf('shots') >= 0 && st.ev.length === 1) acts.push(T.act.dispute[1]);
      var evTxt = st.ev.length ? st.ev.map(function (e) { return label(T.ev, e); }).join('، '.replace('، ', AR ? '، ' : ', ')) : '—';
      var summary = T.sumHead + '\n' + T.sumType + ': ' + label(T.types, st.type) + '\n' + T.sumWhen + ': ' + label(T.when, st.when) + '\n' + T.sumRole + ': ' + label(T.role, st.role) + '\n' + T.sumEv + ': ' + evTxt;
      var h = '<span class="ew-urg ' + lvl + '">' + T.urg[lvl] + '</span><h3>' + T.now + '</h3><ol>' + acts.map(function (a) { return '<li>' + esc(a) + '</li>'; }).join('') + '</ol>';
      if (st.when === 'older' || st.when === 'month') h += '<p class="ew-empty">' + T.olderNote + '</p>';
      h += '<h3>' + T.prep + '</h3><ul>' + T.prepList.map(function (a) { return '<li>' + esc(a) + '</li>'; }).join('') + '</ul>';
      h += '<h3>' + T.sum + '</h3><div class="ew-summary" id="ew-sum">' + esc(summary) + '</div>';
      h += '<div class="ew-nav" style="justify-content:flex-start"><a class="ew-btn wa" target="_blank" rel="noopener" href="' + waLink(summary) + '">' + ICON.wa + ' ' + T.wa + '</a><button type="button" class="ew-btn line" id="ew-copy-sum">' + T.copy + '</button></div>';
      right.innerHTML = h;
      document.getElementById('ew-copy-sum').onclick = function () { copyText(summary, T.copied, document.getElementById('ew-sum')); };
    }
    left.addEventListener('click', function (e) {
      var o = e.target.closest('.ew-opt'), n = e.target.closest('[data-nav]');
      if (o) {
        var v = o.dataset.v;
        if (st.step === 3) { var i = st.ev.indexOf(v); if (i >= 0) st.ev.splice(i, 1); else st.ev.push(v); drawLeft(); }
        else { st[keys[st.step]] = v; st.step++; drawLeft(); var f = left.querySelector('.ew-opt'); if (f) f.focus(); }
        return;
      }
      if (n) {
        if (n.dataset.nav === 'back' && st.step > 0) { st.step--; drawLeft(); }
        else if (n.dataset.nav === 'next') {
          if (st.step < 3 && !st[keys[st.step]]) { toast(T.pick); return; }
          if (st.step === 3) { st.step = 4; drawRight(); left.innerHTML = '<div class="ew-steps" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></div><p class="ew-q">✔ ' + esc(label(T.types, st.type)) + '</p><p class="ew-empty">' + esc(label(T.when, st.when)) + ' · ' + esc(label(T.role, st.role)) + '</p><div class="ew-nav"><button type="button" class="ew-btn line" data-nav="restart">' + T.again + '</button></div>'; if (matchMedia('(max-width:820px)').matches) right.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
          st.step++; drawLeft();
        } else if (n.dataset.nav === 'restart') { st = { step: 0, type: null, when: null, role: null, ev: [] }; drawLeft(); drawRight(); }
      }
    });
    // open with a realistic example so the tool is complete at rest
    st = { step: 4, type: 'ransom', when: 'now', role: 'company', ev: ['pcs', 'logs'] };
    drawRight();
    left.innerHTML = '<div class="ew-steps" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></div><p class="ew-q">' + (AR ? 'مثال: ' : 'Example: ') + esc(label(T.types, 'ransom')) + '</p><p class="ew-empty">' + esc(label(T.when, 'now')) + ' · ' + esc(label(T.role, 'company')) + '</p><div class="ew-nav"><button type="button" class="ew-btn dark" data-nav="restart">' + (AR ? 'ابدأ تقييم حالتك' : 'Start your own assessment') + '</button></div>';
  }

  /* first-24h checklist */
  var ck = document.getElementById('ew-checklist');
  if (ck) {
    var KEY = 'ew-ck-' + (AR ? 'ar' : 'en'), saved = [];
    try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
    ck.innerHTML = '<div class="ew-row"><span class="ew-count" id="ew-ck-count"></span><button type="button" class="ew-btn line" id="ew-ck-reset" style="padding:6px 12px;font-size:.82rem">' + T.ckReset + '</button></div><div class="ew-prog"><i id="ew-ck-bar"></i></div><ul class="ew-check">' +
      T.ck.map(function (c, i) { return '<li><label' + (saved[i] ? ' class="done"' : '') + '><input type="checkbox" id="ew-ck-' + i + '"' + (saved[i] ? ' checked' : '') + '><span><b>' + esc(c[0]) + '</b>' + esc(c[1]) + '</span></label></li>'; }).join('') + '</ul>';
    function upd() {
      var boxes = ck.querySelectorAll('input'), n = 0, st2 = [];
      boxes.forEach(function (b) { st2.push(b.checked); if (b.checked) n++; b.closest('label').classList.toggle('done', b.checked); });
      document.getElementById('ew-ck-count').textContent = T.ckDone + ' ' + n + ' ' + T.ckOf + ' ' + boxes.length;
      document.getElementById('ew-ck-bar').style.width = (n / boxes.length * 100) + '%';
      try { localStorage.setItem(KEY, JSON.stringify(st2)); } catch (e) {}
    }
    ck.addEventListener('change', upd);
    document.getElementById('ew-ck-reset').onclick = function () { ck.querySelectorAll('input').forEach(function (b) { b.checked = false; }); upd(); };
    upd();
  }

  /* evidence hash verifier */
  var hv = document.getElementById('ew-hash');
  if (hv) {
    hv.innerHTML = '<div class="ew-drop" id="ew-drop" tabindex="0" role="button" aria-label="' + esc(T.hDrop) + '"><b>' + T.hDrop + '</b><span>' + T.hPriv + '</span><input type="file" id="ew-file" hidden></div>' +
      '<div class="ew-hashout" id="ew-hashout"><div class="ew-kv"><b>' + T.hName + '</b><span id="ew-fn"></span><b>' + T.hSize + '</b><span id="ew-fs"></span><b>' + T.hMod + '</b><span id="ew-fm"></span></div>' +
      '<div class="ew-row"><b>SHA-256</b><button type="button" class="ew-btn line" id="ew-hcopy" style="padding:5px 12px;font-size:.8rem">' + (AR ? 'نسخ' : 'Copy') + '</button></div><div class="ew-hash" id="ew-h256"></div>' +
      '<label for="ew-cmpin" style="display:block;margin-top:12px;font-size:.88rem;color:var(--ink-2)">' + T.hCmp + '</label><div class="ew-cmp"><input id="ew-cmpin" type="text" spellcheck="false" autocomplete="off"><button type="button" class="ew-btn dark" id="ew-cmpbtn" style="padding:9px 14px">' + T.hBtn + '</button></div><div id="ew-verdict"></div></div>';
    var drop = document.getElementById('ew-drop'), fileIn = document.getElementById('ew-file'), cur = '';
    function fmtSize(b) { return b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : (b / 1048576).toFixed(2) + ' MB'; }
    function handle(f) {
      if (!f) return;
      if (f.size > 500 * 1048576) { toast(T.hBig); return; }
      document.getElementById('ew-hashout').classList.add('show');
      document.getElementById('ew-fn').textContent = f.name; document.getElementById('ew-fs').textContent = fmtSize(f.size);
      document.getElementById('ew-fm').textContent = new Date(f.lastModified).toLocaleString(AR ? 'ar-QA' : 'en-GB');
      document.getElementById('ew-h256').textContent = T.hWork; document.getElementById('ew-verdict').innerHTML = '';
      f.arrayBuffer().then(function (buf) { return crypto.subtle.digest('SHA-256', buf); }).then(function (h) {
        cur = Array.prototype.map.call(new Uint8Array(h), function (b) { return b.toString(16).padStart(2, '0'); }).join('');
        document.getElementById('ew-h256').textContent = cur;
      }).catch(function () { document.getElementById('ew-h256').textContent = 'Web Crypto unavailable'; });
    }
    drop.addEventListener('click', function () { fileIn.click(); });
    drop.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileIn.click(); } });
    fileIn.addEventListener('change', function () { handle(fileIn.files[0]); });
    ['dragenter', 'dragover'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.add('over'); }); });
    ['dragleave', 'drop'].forEach(function (ev) { drop.addEventListener(ev, function (e) { e.preventDefault(); drop.classList.remove('over'); }); });
    drop.addEventListener('drop', function (e) { handle(e.dataTransfer.files[0]); });
    document.getElementById('ew-hcopy').onclick = function () { if (cur) copyText(cur, T.toastCopied, document.getElementById('ew-h256')); };
    document.getElementById('ew-cmpbtn').onclick = function () {
      var v = document.getElementById('ew-cmpin').value.trim().toLowerCase().replace(/\s+/g, ''); if (!cur || !v) return;
      document.getElementById('ew-verdict').innerHTML = '<div class="ew-verdict ' + (v === cur ? 'ok">✔ ' + T.hOk : 'bad">✘ ' + T.hBad) + '</div>';
    };
  }

  /* case-type tabs */
  var tabs = document.getElementById('ew-tabs');
  if (tabs) {
    tabs.innerHTML = '<div class="ew-tabs" role="tablist">' + T.tabs.map(function (t, i) { return '<button type="button" class="ew-tab" role="tab" id="ew-tab-' + t[0] + '" aria-controls="ew-tp" aria-selected="' + (i === 0) + '" tabindex="' + (i === 0 ? 0 : -1) + '" data-i="' + i + '">' + esc(t[1]) + '</button>'; }).join('') + '</div><div class="ew-panel" id="ew-tp" role="tabpanel"></div>';
    function show(i) {
      var t = T.tabs[i];
      tabs.querySelectorAll('.ew-tab').forEach(function (b, k) { b.setAttribute('aria-selected', String(k === i)); b.tabIndex = k === i ? 0 : -1; });
      document.getElementById('ew-tp').setAttribute('aria-labelledby', 'ew-tab-' + t[0]);
      document.getElementById('ew-tp').innerHTML = [2, 3, 4].map(function (k, j) { return '<div><h4>' + T.tH[j] + '</h4><ul>' + t[k].map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul></div>'; }).join('');
    }
    tabs.addEventListener('click', function (e) { var b = e.target.closest('.ew-tab'); if (b) show(+b.dataset.i); });
    tabs.addEventListener('keydown', function (e) {
      var b = e.target.closest('.ew-tab'); if (!b) return; var i = +b.dataset.i, n = T.tabs.length, d = 0;
      if (e.key === 'ArrowRight') d = AR ? -1 : 1; if (e.key === 'ArrowLeft') d = AR ? 1 : -1;
      if (d) { e.preventDefault(); var k = (i + d + n) % n; show(k); tabs.querySelectorAll('.ew-tab')[k].focus(); }
    });
    show(0);
  }

  /* animated credibility counters (values are correct at rest) */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.ew-cred [data-n]').forEach(function (el) {
      var n = (el.dataset.stat && window.SCHOLAR && window.SCHOLAR[el.dataset.stat]) || +el.dataset.n, suf = el.dataset.suf || '', t0 = performance.now();
      (function step(t) { var k = Math.min(1, (t - t0) / 1100), v = Math.round(n * (1 - Math.pow(1 - k, 3))); el.textContent = v.toLocaleString('en-US') + suf; if (k < 1) requestAnimationFrame(step); })(t0);
    });
  }
})();
