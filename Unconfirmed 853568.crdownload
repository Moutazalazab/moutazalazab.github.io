    act: {
      ransom: ['Disconnect affected machines from the network. Do not switch them off or reinstall them.', 'Photograph the ransom note and screens. Do not negotiate or pay before evidence is preserved.', 'Export firewall, VPN and email logs now, before they roll over.'],
      breach: ['Identify the systems and data likely affected, without altering them.', 'Export access and audit logs and extend their retention.', 'Record how and when the leak was discovered, and who has seen it.'],
      bec: ['Keep the original emails with full headers. Do not forward them around.', 'Contact your bank immediately to try to stop or recall the transfer.', 'After preserving logs, reset the affected mailbox password and enable two-factor sign-in.'],
      hack: ['Isolate affected systems from the network but keep them running.', 'Preserve logs and the list of active accounts before changing anything.', 'Keep the number of people touching the systems to a minimum, and log every action.'],
      insider: ['Do not confront the employee before evidence is preserved.', 'Secure their devices and accounts exactly as they are, without using them.', 'Collect email, cloud and USB/external-storage logs.'],
      dispute: ['Keep the devices or accounts holding the originals, not forwarded copies.', 'Do not rely on screenshots alone; they are easy to challenge.', 'Note where each message or file came from, who held it and when.'],
      mobile: ['Do not factory-reset or update the phone.', 'Switch on airplane mode or use a signal-blocking bag to prevent remote wiping.', 'Keep the phone charged and note the passcode if known.'],
      wa: ['Keep the original phone that holds the chat. Do not delete or reinstall WhatsApp.', 'Do not rely on screenshots alone; export the full chat with media if you can.', 'Check that a recent Google Drive or iCloud backup exists.'],
      sale: ['Keep the disputed device or software as it is. Do not repair or modify it.', 'Collect the contract, invoices, agreed specifications and messages with the seller.', 'Photograph the device and visible defects, and note serial numbers.'],
      value: ['Collect the purchase invoice, date and full specifications.', 'Do not repair or open the device before inspection.', 'Note visible faults, accessories included and warranty status.'],
      other: ['Do not wipe or reinstall any devices.', 'Write down what happened in time order and who did what.', 'Preserve related logs and messages exactly as they are.']
